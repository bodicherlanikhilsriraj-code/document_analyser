# Ollama runs locally by default. No API key is required.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=Qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_TEMPERATURE=0.2
OLLAMA_MAX_OUTPUT_TOKENS=1024

# Local sentence-transformers embedding model (downloaded on first use).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval and ingestion defaults.
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
RETRIEVAL_COUNT=5
RELEVANCE_THRESHOLD=0.15
MAX_UPLOAD_MB=25

# Optional custom location; relative paths resolve from the app launch directory.
# STUDYPILOT_DATA_DIR=D:\StudyPilotData
